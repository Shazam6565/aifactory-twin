#usda 1.0

# Deliberately no PhysicsCollisionAPI anywhere in the subtree — this fixture
# exists to make rigidbody_has_collider fail while everything else stays valid.
over "Rack" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 1000

    over "Body"
    {
    }
}
