#usda 1.0

over "Rack"
{
    def Scope "Looks"
    {
        def Material "RackMaterial"
        {
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.2, 0.2)
            }
        }
    }

    # Deliberately no rel material:binding authored — this is the fixture's
    # one defect. MaterialBindingAPI is applied but never bound to anything,
    # so ComputeBoundMaterial() must resolve to no material.
    over "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
    }
}

