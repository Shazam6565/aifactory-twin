#usda 1.0

def "Looks"
{
    def Material "RackMaterial"
    {
        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.2, 0.2, 0.2)
        }
    }
}

over "Rack"
{
    over "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/RackMaterial>
    }
}

